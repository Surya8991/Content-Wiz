#!/bin/sh
# Content-Wiz pre-push gate. Guards (main-branch, identity, secrets) come from
# lib/guards.sh; the checks below are specific to this project (Python CLI).
# Enable once per clone: git config core.hooksPath .githooks   (see README.md)
HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
. "$HOOK_DIR/lib/guards.sh"
pp_init "$@"
pp_run_guards || exit 1
pp_should_check || exit 0

pp_find_python
pp_step "content-rule lint"  "$PP_PY" lint_content.py
pp_py_step_if ruff "ruff lint" "$PP_PY" -m ruff check .
pp_step "unit tests"         "$PP_PY" -m unittest discover -p "test_*.py"
pp_done
