#!/usr/bin/env bash
# Content Wiz pre-commit hook: enforce content rules + tests before every commit.
# Superseded by .githooks/pre-push, which runs these checks before every push
# (core.hooksPath is .githooks). Still handy to run by hand: bash hooks/pre-commit
set -e

repo_root="$(git rev-parse --show-toplevel)"

echo "[pre-commit] content-rule lint..."
python "$repo_root/lint_content.py"

echo "[pre-commit] ruff lint..."
ruff check "$repo_root"

echo "[pre-commit] unit tests..."
python -m unittest discover -s "$repo_root" -p "test_*.py"

echo "[pre-commit] ok"
